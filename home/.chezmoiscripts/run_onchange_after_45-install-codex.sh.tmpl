{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

codex_dir="$HOME/.local/bin"
codex_path="$codex_dir/codex"

if [[ -x "$codex_path" ]]; then
  exit 0
fi

if [[ -e "$codex_path" ]]; then
  printf 'dotfiles: Codex install path exists but is not executable: %s\n' "$codex_path" >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  printf 'dotfiles: curl is required to install Codex CLI.\n' >&2
  exit 1
fi

mkdir -p "$codex_dir"

# OpenAI standalone installer; keep its managed binary ahead of mise shims.
curl -fsSL https://chatgpt.com/codex/install.sh | env \
  PATH="$codex_dir:$PATH" \
  CODEX_INSTALL_DIR="$codex_dir" \
  CODEX_NON_INTERACTIVE=true \
  sh

if [[ ! -x "$codex_path" ]]; then
  printf 'dotfiles: Codex installation failed: %s was not created.\n' "$codex_path" >&2
  exit 1
fi
{{ end -}}
