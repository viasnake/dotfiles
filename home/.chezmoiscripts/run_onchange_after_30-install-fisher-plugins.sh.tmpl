{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

load_homebrew_env() {
  local brew_bin

  for brew_bin in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew
  do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      return
    fi
  done

  return 1
}

plugins_file="$HOME/.config/fish/fish_plugins"
# fish_plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

load_homebrew_env || true

if ! command -v fish >/dev/null 2>&1; then
  printf 'dotfiles: fish is unavailable; cannot install Fisher plugins.\n' >&2
  exit 1
fi

ensure_fisher() {
  if fish -c 'functions -q fisher' >/dev/null 2>&1; then
    return
  fi

  if ! command -v curl >/dev/null 2>&1; then
    printf 'dotfiles: curl is required to install fisher.\n' >&2
    exit 1
  fi

  fish -c 'curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher install jorgebucaran/fisher'
}

if [[ ! -f "$plugins_file" ]]; then
  exit 0
fi

plugins="$(tr '\n' ' ' < "$plugins_file")"
if [[ -z "${plugins// }" ]]; then
  exit 0
fi

ensure_fisher
fish -c "fisher install $plugins"
{{ end -}}
