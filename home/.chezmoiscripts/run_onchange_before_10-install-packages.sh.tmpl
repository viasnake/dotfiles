{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

run_as_root() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    printf 'dotfiles: sudo is required to install system packages.\n' >&2
    exit 1
  fi
}

{{- if eq .chezmoi.os "linux" }}
{{- if and (hasKey .chezmoi.osRelease "id") (or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "raspbian") (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "zorin")) }}
if command -v apt-get >/dev/null 2>&1; then
  run_as_root env DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get update
  run_as_root env DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y \
    build-essential \
    ca-certificates \
    curl \
    file \
    fish \
    git \
    libicu-dev \
    procps \
    sqlite3 \
    unzip
else
  printf 'dotfiles: apt-get is required on supported Debian-based Linux systems.\n' >&2
  exit 1
fi
{{- else }}
printf 'dotfiles: unsupported Linux distribution; Debian and Ubuntu package installation is required.\n' >&2
exit 1
{{ end }}

{{- else }}
load_homebrew_env() {
  local brew_bin

  for brew_bin in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew
  do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      return 0
    fi
  done

  return 1
}

load_homebrew_env || true

if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

load_homebrew_env || true

if ! command -v brew >/dev/null 2>&1; then
  printf 'dotfiles: Homebrew installation did not provide a usable brew command.\n' >&2
  exit 1
fi

if ! command -v fish >/dev/null 2>&1; then
  brew install fish
fi
if ! command -v sqlite3 >/dev/null 2>&1; then
  brew install sqlite
fi
{{- end }}
{{ end -}}
