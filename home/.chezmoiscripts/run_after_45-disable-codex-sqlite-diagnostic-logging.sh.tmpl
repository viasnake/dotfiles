{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

codex_home="${CODEX_HOME:-$HOME/.codex}"
config_path="$codex_home/config.toml"
sqlite_home="${CODEX_SQLITE_HOME:-$codex_home}"

read_top_level_sqlite_home() {
  local path="$1"

  [[ -f "$path" ]] || return 0

  awk '
    /^[[:space:]]*\[/ {
      exit
    }

    /^[[:space:]]*sqlite_home[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)

      quote = substr(value, 1, 1)
      if (quote == "\"" || quote == "\047") {
        output = ""
        escaped = 0

        for (character_index = 2; character_index <= length(value); character_index++) {
          character = substr(value, character_index, 1)

          if (quote == "\"" && escaped) {
            output = output character
            escaped = 0
            continue
          }

          if (quote == "\"" && character == "\\") {
            escaped = 1
            continue
          }

          if (character == quote) {
            print output
            exit
          }

          output = output character
        }

        exit 1
      }

      sub(/[[:space:]]+#.*$/, "", value)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print value
      exit
    }
  ' "$path"
}

expand_user_path() {
  local path="$1"

  case "$path" in
    "~")
      printf '%s\n' "$HOME"
      ;;
    "~/"*)
      printf '%s/%s\n' "$HOME" "${path#~/}"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

configured_sqlite_home="$(read_top_level_sqlite_home "$config_path")"
if [[ -n "$configured_sqlite_home" ]]; then
  sqlite_home="$configured_sqlite_home"
fi

sqlite_home="$(expand_user_path "$sqlite_home")"
if [[ "$sqlite_home" != /* ]]; then
  sqlite_home="$PWD/$sqlite_home"
fi

log_database="$sqlite_home/logs_2.sqlite"
if [[ ! -f "$log_database" ]]; then
  exit 0
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  printf 'dotfiles: sqlite3 is required to disable Codex diagnostic logging in %s.\n' "$log_database" >&2
  exit 1
fi

logs_table_exists="$(
  sqlite3 -readonly -noheader "$log_database" \
    "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = 'logs';"
)"

if [[ "$logs_table_exists" != "1" ]]; then
  printf 'dotfiles: expected logs table is missing from %s; leaving the database unchanged.\n' "$log_database" >&2
  exit 1
fi

sqlite3 -batch -cmd '.timeout 10000' "$log_database" \
  "CREATE TRIGGER IF NOT EXISTS block_log_inserts
   BEFORE INSERT ON logs
   BEGIN
     SELECT RAISE(IGNORE);
   END;"

trigger_exists="$(
  sqlite3 -readonly -noheader "$log_database" \
    "SELECT COUNT(*) FROM sqlite_master WHERE type = 'trigger' AND name = 'block_log_inserts';"
)"

if [[ "$trigger_exists" != "1" ]]; then
  printf 'dotfiles: failed to disable Codex diagnostic logging in %s.\n' "$log_database" >&2
  exit 1
fi

printf 'dotfiles: Codex SQLite diagnostic logging is disabled in %s.\n' "$log_database"
{{ end -}}
