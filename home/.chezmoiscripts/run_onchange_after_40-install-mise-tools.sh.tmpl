{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash

set -euo pipefail

load_homebrew_env() {
  local brew_bin

  for brew_bin in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew
  do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      return
    fi
  done

  return 1
}

resolve_mise() {
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    printf '%s\n' "$HOME/.local/bin/mise"
    return 0
  fi

  command -v mise 2>/dev/null || true
}

mise_config="$HOME/.config/mise/config.toml"
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

load_homebrew_env || true

if [[ ! -f "$mise_config" ]]; then
  exit 0
fi

mise_bin="$(resolve_mise)"
if [[ -z "$mise_bin" ]]; then
  printf 'dotfiles: mise is unavailable; run the bootstrap step again.\n' >&2
  exit 1
fi

"$mise_bin" install -y
{{ end -}}
